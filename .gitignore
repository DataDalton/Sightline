# Compiled output must never land beside sources
backend/ui/app/**/*.js
backend/ui/lib/**/*.js
backend/ui/**/*.tsbuildinfo

# Organisation branding. Trademarks belong to whoever owns them, not in a
# repository other people read. A deployment loads its mark through
# Administration -> Configuration.
branding/

# Import scripts that know one organisation's planning format. The platform
# ships a generic importer; anything that understands a particular set of
# planning documents belongs to whoever wrote them.
#
# Leading ** because a pattern containing a slash is anchored to the directory
# holding this file. Written as "scripts/local/" it matched only a directory at
# the repository root, and the one that exists is under backend/ui.
**/scripts/local/

# Editor account configuration. Holds a personal GitHub identity and has no
# business in a repository other people read.
.vscode/github-accounts.json
