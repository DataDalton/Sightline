		"react-dom": "^19.2.8",
		"swr": "^2.5.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"typescript": "^7.0.2"
