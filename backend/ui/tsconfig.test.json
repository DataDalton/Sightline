{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rootDir": "lib",
		"outDir": "../../.test-build",
		"types": ["node"],
		"verbatimModuleSyntax": false,
