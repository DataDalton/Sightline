		"lib/search/types.ts",
		"lib/semantic/types.ts",
		"lib/semantic/metricViewDefinition.ts",
		"lib/semantic/rowFilterGroups.ts",
		"lib/semantic/rowFilterGroups.test.ts",
		"lib/semantic/metricViewDefinition.test.ts",
		"lib/platform/overlay.ts",
		"lib/platform/versionDiff.ts",
		"lib/platform/versionDiff.test.ts",
		"lib/platform/overlay.test.ts",
		"lib/format.ts",
		"lib/hostname.ts",
		"lib/hostname.test.ts",
		"lib/visuals/style.ts",
		"lib/visuals/style.test.ts",
		"lib/visuals/brush.ts",
		"lib/visuals/svgSanitize.ts",
		"lib/visuals/svgSanitize.test.ts",
		"lib/visuals/brush.test.ts",
		"lib/visuals/layout.ts",
