# Local development only.
#
# A deployed Databricks App never reads this file. It declares itself in
# app.yaml and receives DATABRICKS_HOST, DATABRICKS_CLIENT_ID and
# DATABRICKS_CLIENT_SECRET from the platform, and its connection targets from
# the resource bindings.
#
# Everything that is not a connection target lives in the platform_settings
# table and is edited in Administration → Configuration: branding, cache
# budgets, editor and admin groups, the warehouse and catalogue the reports
# read. None of that belongs here.
#
# Copy to .env and fill in. .env is ignored by git. Never commit a token.

# --- Databricks workspace ---------------------------------------------------
# Host of the workspace, without a scheme.
WAREHOUSE_HOST=adb-0000000000000000.0.azuredatabricks.net

# The SQL warehouse that runs queries. The id is the last segment of the
# warehouse HTTP path.
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/REPLACE_ME

# Service principal OAuth credentials. Preferred over a personal token: it is
# the same auth path the deployed app uses, and a principal can be scoped far
# more tightly than a person.
#
# Grant the principal only what it needs: CAN_USE on the warehouse, a Postgres
# role in the Lakebase instance, and write access to its own schema.
# Deliberately do NOT grant it access to the analytical views. Every data query
# runs under the caller's own token so Unity Catalog can filter it, and a
# principal that cannot read those views turns that into a permission guarantee
# rather than a promise about the code.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Personal access token. An alternative for quick local work, carrying the full
# access of whoever issued it. Prefer the principal above.
DATABRICKS_TOKEN=

# --- Lakebase, which holds the platform's own tables ------------------------
# Reports, pages, visuals, saved views, access policy, settings and the usage
# log. There is no Postgres password: the driver mints a short-lived OAuth
# token against the instance and rotates it.
PGHOST=instance-00000000-0000-0000-0000-000000000000.database.azuredatabricks.net
PGPORT=5432
PGDATABASE=
PGSSLMODE=require

# Schema holding the platform tables. Dedicated rather than public, so they are
# isolated and can be dropped as a unit.
PGSCHEMA=sightline

# The database instance name. Credentials are minted against this, not against
# the host, and it cannot be derived from the host.
LAKEBASE_INSTANCE=

# The service principal client id when running as a principal, or your own
# email address for a personal identity.
PGUSER=

# --- The data the reports read ----------------------------------------------
# A starting value. Once an administrator sets the catalogue in
# Administration → Configuration, the stored setting wins.
SOURCE_CATALOG=

# --- Bootstrapping access ---------------------------------------------------
# The group that administers a fresh install.
#
# Without it an empty settings table means nobody is an administrator, and the
# page that appoints administrators is itself administrator-only, so a new
# install could never be configured. Once the table names a group this is
# ignored and can be removed.
#
# Case sensitive: is_account_group_member matches the name exactly as the
# account spells it, and the wrong case fails silently as a non-member rather
# than as an error.
BOOTSTRAP_ADMIN_GROUPS=

# --- Local identity ---------------------------------------------------------
# Stands in for the proxy header that a deployed app receives. Ignored in a
# deployed app, where an unauthenticated request is refused rather than served
# as somebody.
LOCAL_IDENTITY_EMAIL=you@example.com
